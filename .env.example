# Copy to .env. This is a shell configuration file; only use trusted content.
# 设备 IP：留空或省略也可启动服务（管理页可用），补充后重启或在管理页重连。
ZECTRIX_IP=192.168.1.100
# 输出格式：gray4（默认）/ mono / gray16。
ZECTRIX_FORMAT=gray4
# 浏览器模式：auto（系统 Chrome 优先）/ chrome / chromium。
WEREAD_BROWSER=auto
# 管理页端口（仅绑定 127.0.0.1）。
WEREAD_HTTP_PORT=8765
# 灰度黑点：0~249，0 表示关闭增强。
WEREAD_INK_BLACK_POINT=200
